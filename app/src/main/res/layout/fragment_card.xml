<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/subscribe_card"

    tools:context=".card">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/cardTitle"
        android:layout_width="335dp"
        android:layout_height="47dp"
        android:layout_marginBottom="8dp"
        android:shadowColor="#AA000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="3"
        android:text=" Tramway Subscriber Card"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.362"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.123" />
    <com.labsisouleimanedev.touchflip3d.RotateView2
        android:id="@+id/flipView"
        android:layout_width="320dp"
        android:layout_height="220dp"
       app:flipDirection="horizontal"
        app:showShadows="true"
        app:showGlossyEffect="false"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.666"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:layout_marginHorizontal="16dp">



    <androidx.cardview.widget.CardView
        android:id="@+id/cardView2"

        android:layout_width="320dp"
        android:layout_height="220dp"
        android:layout_marginBottom="228dp"
        android:backgroundTint="#A30E1845"
        android:elevation="8dp"
        app:cardCornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card">

            <!-- إطار زخرفي داخلي -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:background="@drawable/border_frame" />

            <!-- العنوان داخل البطاقة -->
            <TextView
                android:id="@+id/internalCardTitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بطاقة اشتراك الترامواي"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- شريحة البطاقة -->
            <ImageView
                android:id="@+id/chipView2"
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="32dp"
                android:src="@drawable/caadetude2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- تاريخ انتهاء الصلاحية -->
            <TextView
                android:id="@+id/expiryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تاريخ انتهاء:"
                android:textColor="#CCCCCC"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toBottomOf="@id/chipView2"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/expiryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025-12-31"
                android:textColor="#11B811"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toBottomOf="@id/expiryLabel"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- حالة الاشتراك -->
            <TextView
                android:id="@+id/subscriptionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صالحة للاستعمال ✅"
                android:textColor="#11B811"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toBottomOf="@id/expiryDate"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- الأيام المتبقية -->


            <!-- رقم التسجيل -->


            <!-- QR Code بإطار مزخرف -->

            <TextView
                android:id="@+id/daysRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="188dp"
                android:layout_marginTop="28dp"
                android:text="الأيام المتبقية: 15"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/internalCardTitle2" />

            <FrameLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/qrCode2"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/codeqricon" />

                <!-- زخرفة الحواف -->
                <View
                    android:layout_width="30dp"
                    android:layout_height="4dp"
                    android:layout_gravity="top|start"
                    android:background="#11E6CE" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|start"
                    android:background="#11E6CE" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="4dp"
                    android:layout_gravity="top|end"
                    android:background="#11E6CE" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:background="#11E6CE" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom|start"
                    android:background="#11E6CE" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|start"
                    android:background="#11E6CE" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom|end"
                    android:background="#11E6CE" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:background="#11E6CE" />
            </FrameLayout>



        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="320dp"

            android:layout_height="220dp"
            android:backgroundTint="#A30E1845"
            android:elevation="8dp"
            app:cardCornerRadius="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.493"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.666">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card">

                <!-- إطار زخرفي داخلي -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:background="@drawable/border_frame" />

                <!-- العنوان داخل البطاقة -->
                <TextView
                    android:id="@+id/internalCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="بطاقة اشتراك الترامواي"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- شريحة البطاقة -->
                <ImageView
                    android:id="@+id/chipView"
                    android:layout_width="40dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="32dp"
                    android:src="@drawable/caadetude2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- صورة المستخدم -->

                <!-- الاسم -->
                <TextView
                    android:id="@+id/fullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:text="اسم المستخدم"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/chipView" />

                <!-- اللقب -->
                <TextView
                    android:id="@+id/lastName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="لقب المستخدم"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/fullName" />

                <!-- عنوان رقم التسجيل -->
                <TextView
                    android:id="@+id/idLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:text="رقم التسجيل:"
                    android:textColor="#CCCCCC"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lastName" />

                <!-- رقم التسجيل -->
                <TextView
                    android:id="@+id/idNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="02350750"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/idLabel" />

                <!-- QR Code بإطار مزخرف -->
                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/qrCode"
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/codeqricon" />

                    <!-- زخرفة الحواف -->
                    <View
                        android:layout_width="30dp"
                        android:layout_height="4dp"
                        android:layout_gravity="top|start"
                        android:background="#11E6CE" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="30dp"
                        android:layout_gravity="top|start"
                        android:background="#11E6CE" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="4dp"
                        android:layout_gravity="top|end"
                        android:background="#11E6CE" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="30dp"
                        android:layout_gravity="top|end"
                        android:background="#11E6CE" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="4dp"
                        android:layout_gravity="bottom|start"
                        android:background="#11E6CE" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom|start"
                        android:background="#11E6CE" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="4dp"
                        android:layout_gravity="bottom|end"
                        android:background="#11E6CE" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom|end"
                        android:background="#11E6CE" />
                </FrameLayout>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profileImage"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/circle_background"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </com.labsisouleimanedev.touchflip3d.RotateView2>
</androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>

